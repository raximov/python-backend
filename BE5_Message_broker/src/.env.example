DB_HOST=localhost
DB_PORT=5434
DB_NAME=shop_db
DB_USER=shop_user
DB_PASSWORD=shop_password

READONLY_DB_PASSWORD=shop_read_password

DATABASE_URL=postgresql+psycopg://shop_user:shop_password@localhost:5434/shop_db
READONLY_DATABASE_URL=postgresql+psycopg://shop_reader:shop_read_password@127.0.0.1:5434/shop_db

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Authorization Service
AUTH_DB_NAME=auth_db
AUTH_DATABASE_URL=postgresql+psycopg://shop_user:shop_password@localhost:5434/auth_db

GRPC_HOST=127.0.0.1
GRPC_PORT=50051

JWT_SECRET_KEY=change-this-secret-in-real-environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# RabbitMQ
RABBITMQ_USER=shop_mq_user
RABBITMQ_PASSWORD=shop_mq_password
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://shop_mq_user:shop_mq_password@127.0.0.1:5673/
RABBITMQ_EXCHANGE=product.events
RABBITMQ_QUEUE=gateway.product.updates
RABBITMQ_ROUTING_KEY=product.attributes.updated

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6380/0
IMAGE_CACHE_TTL_SECONDS=3600

# Event generator
EVENT_GENERATOR_INTERVAL_SECONDS=5

# Application ports
GATEWAY_PORT=8000
AUTH_GRPC_HOST_PORT=50051
