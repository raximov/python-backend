		{
			"name": "Part 2 - HH.uz Developer Tools",
			"item": [
				{
					"name": "HH.uz - Vakansiya kontakt ma'lumotlari",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "accept",
								"value": "application/json"
							},
							{
								"key": "cookie",
								"value": "{{HH_COOKIE}}",
								"description": "Chrome DevTools -> Network -> so'rov -> Request Headers -> cookie ni to'liq ko'chiring"
							},
							{
								"key": "x-xsrftoken",
								"value": "{{HH_XSRF_TOKEN}}",
								"description": "Chrome DevTools dagi x-xsrftoken qiymati"
							},
							{
								"key": "x-requested-with",
								"value": "XMLHttpRequest"
							},
							{
								"key": "user-agent",
								"value": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36"
							},
							{
								"key": "referer",
								"value": "https://tashkent.hh.uz/vacancy/130540433"
							},
							{
								"key": "x-hhtmfrom",
								"value": "main"
							},
							{
								"key": "x-hhtmsource",
								"value": "vacancy"
							}
						],
						"url": {
							"raw": "https://tashkent.hh.uz/shards/vacancy/contact_info?employer_id=5810442&id=130556793",
							"protocol": "https",
							"host": [
								"tashkent",
								"hh",
								"uz"
							],
							"path": [
								"shards",
								"vacancy",
								"contact_info"
							],
							"query": [
								{
									"key": "employer_id",
									"value": "5810442",
									"description": "Employer ID - Chrome DevTools dan olingan"
								},
								{
									"key": "id",
									"value": "130556793",
									"description": "Vacancy ID - Chrome DevTools dan olingan"
								}
							]
						},
						"description": "HH.uz vakansiya kontakt ma'lumotlari.\n\n⚠️ 401 MUAMMOSINI HAL QILISH:\nBu API session cookie talab qiladi. Quyidagilarni Chrome DevTools dan ko'chiring:\n\n1. Chrome -> hh.uz -> F12 -> Network -> Fetch/XHR\n2. 'Kontaktlarni ko'rsatish' tugmasini bosing\n3. contact_info so'rovini toping\n4. Request Headers bo'limidan:\n   - 'cookie' qiymatini to'liq nusxa olib HH_COOKIE variabliga yozing\n   - 'x-xsrftoken' qiymatini HH_XSRF_TOKEN variabliga yozing\n5. So'rovni qayta yuboring - 200 OK keladi!"
					},
					"response": []
				}
			]
		},
